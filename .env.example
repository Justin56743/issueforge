# ==============================================================================
# Issueforge Configuration
# Autonomous Multi-LLM Git Agent & Telegram HITL Orchestrator
# ==============================================================================

# Server & Dashboard Settings
# A non-loopback host requires FORGE_AUTH_TOKEN to be set, or the server refuses to start.
FORGE_HOST=127.0.0.1
FORGE_PORT=8000
FORGE_DEBUG=false
# FORGE_AUTH_TOKEN=
FORGE_BASE_URL=http://localhost:8000

# Obsidian Vault & Storage (Jetson Nano Orin friendly)
# FORGE_VAULT_ROOT is the single directory Issueforge treats as an Obsidian vault. Open it in
# Obsidian to inspect the task graph and each task's live execution canvas.
# The task dossiers, sandbox workspaces and the SQLite database all derive from it unless
# overridden below, so setting only this keeps everything in one tree.
FORGE_VAULT_ROOT=~/.issueforge
# Optional explicit overrides (each wins over FORGE_VAULT_ROOT):
# FORGE_TASKS_ROOT=~/.issueforge/tasks
# FORGE_WORKSPACE_ROOT=~/.issueforge/workspaces
# FORGE_DB_PATH=~/.issueforge/issueforge.db

# Live Obsidian canvas telemetry and reverse steering from canvas notes
FORGE_CANVAS_ENABLED=true
FORGE_CANVAS_WATCH_ENABLED=true
FORGE_EXECUTION_TIMEOUT_SECONDS=600

# Telegram Bot (Human-in-the-Loop)
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather
# Comma-separated list of allowed Telegram user IDs
TELEGRAM_ALLOWED_USER_IDS=123456789

# GitHub Integration
GITHUB_TOKEN=ghp_your_github_personal_access_token
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret

# GitLab Integration
GITLAB_URL=https://gitlab.com
GITLAB_TOKEN=glpat-your_gitlab_personal_access_token
GITLAB_WEBHOOK_SECRET=your_gitlab_webhook_secret

# Multi-LLM Agent Roles (using LiteLLM model identifiers)
# Supported: gemini/..., anthropic/..., openai/..., deepseek/..., ollama/...
PLANNER_MODEL=gemini/gemini-2.5-pro
CODER_MODEL=gemini/gemini-2.5-pro
TESTER_MODEL=gemini/gemini-2.5-flash
REVIEWER_MODEL=gemini/gemini-2.5-pro

# LLM API Keys (Set whichever providers you use)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
OLLAMA_API_BASE=http://localhost:11434

# Background Task Polling (GitLab Todos & GitHub Notifications)
POLL_ENABLED=true
POLL_INTERVAL_HOURS=8.0
AUTO_MARK_TODO_DONE=true
